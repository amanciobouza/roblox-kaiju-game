</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>1.55</X><Y>5.2</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>1810.67836387</X><Y>80.00000000</Y><Z>2228.08514105</Z><R00>0.0000000000</R00><R01>-0.9927662518</R01><R02>-0.1200631888</R02><R10>1.0000000000</R10><R11>0.0000000000</R11><R12>0.0000000000</R12><R20>0.0000000000</R20><R21>-0.1200631888</R21><R22>0.9927662518</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX1070"><Properties><string name="Name">RadiationTrefoil</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>1.55</X><Y>5.2</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>1810.77187444</X><Y>78.92338130</Y><Z>2228.09645003</Z><R00>-0.1723920505</R00><R01>-0.9776839017</R01><R02>-0.1200631888</R02><R10>0.9848077530</R10><R11>-0.1736481777</R11><R12>0.0000000000</R12><R20>-0.0208487539</R20><R21>-0.1182391592</R21><R22>0.9927662518</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX1071"><Properties><string name="Name">RadiationTrefoil</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name