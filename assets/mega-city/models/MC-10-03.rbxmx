></Properties></Item><Item class="Part" referent="RBX559"><Properties><string name="Name">LadderRung</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4282470238</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>6</X><Y>0.8</Y><Z>0.8</Z></Vector3><CoordinateFrame name="CFrame"><X>794.46482659</X><Y>50.00000000</Y><Z>2860.20350518</Z><R00>0.9968569981</R00><R01>0.0000000000</R01><R02>0.0792220002</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0792220002</R20><R21>0.0000000000</R21><R22>0.9968569981</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX560"><Properties><string name="Name">LadderRung</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4282470238</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>6</X><Y>0.8</Y><Z>0.8</Z></Vector3><CoordinateFrame name="CFrame"><X>794.46482659</X><Y>54.00000000</Y><Z>2860.20350518</Z><R00>0.9968569981</R00><R01>0.0000000000</R01><R02>0.0792220002</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0792220002</R20><R21>0.0000000000</R21><R22>0.9968569981</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX561"><Properties><string name="Name">LadderRung</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token