>288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>1.55</X><Y>5.2</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>1330.78602957</X><Y>60.00000000</Y><Z>1142.98517633</Z><R00>0.0000000000</R00><R01>-0.9999702565</R01><R02>-0.0077127231</R02><R10>1.0000000000</R10><R11>0.0000000000</R11><R12>0.0000000000</R12><R20>0.0000000000</R20><R21>-0.0077127231</R21><R22>0.9999702565</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX1070"><Properties><string name="Name">RadiationTrefoil</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>1.55</X><Y>5.2</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>1330.88021870</X><Y>58.92338130</Y><Z>1142.98590281</Z><R00>-0.1736430128</R00><R01>-0.9847784614</R01><R02>-0.0077127231</R02><R10>0.9848077530</R10><R11>-0.1736481777</R11><R12>0.0000000000</R12><R20>-0.0013393003</R20><R21>-0.0075955495</R21><R22>0.9999702565</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX1071"><Properties><string name="Name">RadiationTrefoil</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4286316335</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>1.55</X><Y>5.2</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>1331.15992420</X><Y