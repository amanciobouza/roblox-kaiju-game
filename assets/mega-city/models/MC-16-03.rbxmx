ties></Item><Item class="Part" referent="RBX350"><Properties><string name="Name">CeilingLight</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4294946893</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>17</X><Y>1</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>1102.58928441</X><Y>230.00000000</Y><Z>6161.89700634</Z><R00>0.9984477143</R00><R01>0.0000000000</R01><R02>0.0556970547</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0556970547</R20><R21>0.0000000000</R21><R22>0.9984477143</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX351"><Properties><string name="Name">CeilingLight</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4294946893</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>17</X><Y>1</Y><Z>6</Z></Vector3><CoordinateFrame name="CFrame"><X>1009.30036836</X><Y>230.00000000</Y><Z>6213.17251845</Z><R00>0.9984477143</R00><R01>0.0000000000</R01><R02>0.0556970547</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0556970547</R20><R21>0.0000000000</R21><R22>0.9984477143</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX352"><Properties><string name="Name">CeilingLight</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><