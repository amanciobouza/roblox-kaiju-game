><token name="shape">1</token><Vector3 name="size"><X>14</X><Y>1</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>-1104.81122074</X><Y>78.50000000</Y><Z>2322.23167029</Z><R00>0.9874403259</R00><R01>0.0000000000</R01><R02>0.1579924139</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.1579924139</R20><R21>0.0000000000</R21><R22>0.9874403259</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX595"><Properties><string name="Name">RearFrame</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4282470238</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>14</X><Y>1</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>-1104.81122074</X><Y>87.50000000</Y><Z>2322.23167029</Z><R00>0.9874403259</R00><R01>0.0000000000</R01><R02>0.1579924139</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.1579924139</R20><R21>0.0000000000</R21><R22>0.9874403259</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX596"><Properties><string name="Name">RearWindow</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0.2</float><token name="Material">1568</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4280509582</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>12</X><Y>7</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>-1104.68482681</X><Y>83.00000000</Y><Z>2323.02162255</Z><R00>0.9874403259</R00><R01>0.0000000000</R01><R02>0.1579924139</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12