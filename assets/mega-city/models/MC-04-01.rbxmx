loat><token name="Material">1568</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4280509582</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>12</X><Y>7</Y><Z>0.6</Z></Vector3><CoordinateFrame name="CFrame"><X>-1513.80801476</X><Y>89.00000000</Y><Z>958.80193292</Z><R00>0.9963118664</R00><R01>0.0000000000</R01><R02>0.0858059726</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0858059726</R20><R21>0.0000000000</R21><R22>0.9963118664</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX593"><Properties><string name="Name">RearWarm</string><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4294946893</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>10</X><Y>0.7</Y><Z>0.7</Z></Vector3><CoordinateFrame name="CFrame"><X>-1513.76511177</X><Y>86.50000000</Y><Z>959.30008885</Z><R00>0.9963118664</R00><R01>0.0000000000</R01><R02>0.0858059726</R02><R10>0.0000000000</R10><R11>1.0000000000</R11><R12>0.0000000000</R12><R20>-0.0858059726</R20><R21>0.0000000000</R21><R22>0.9963118664</R22></CoordinateFrame></Properties></Item><Item class="Part" referent="RBX594"><Properties><string name="Name">RearFrame</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanQuery">true</bool><bool name="CanTouch">false</bool><float name="Transparency">0</float><token name="Material">1088</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><Color3uint8 name="Color3uint8">4282470238</Color3uint8><token name="shape">1</token><Vector3 name="size"><X>14</X><Y>1</Y><Z>1</Z></Vector3><CoordinateFrame name="CFrame"><X>-1494.94673408</X><Y>58.5000